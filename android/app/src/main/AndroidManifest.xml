<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Red: consulta a MockAPI y Open-Meteo (R2..R10) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- R7 · Ubicación: GPS actual para la incidencia y para el clima.
         Sin estos permisos @capacitor/geolocation falla siempre en Android;
         si el usuario los deniega, la app ofrece coordenadas manuales. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- R6 · Cámara: evidencia fotográfica. Al declararse, el plugin pide el
         permiso en tiempo de ejecución y la app explica el caso denegado. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- La app no escribe en el almacenamiento compartido: la foto viaja en
         base64 dentro del registro (R6), así que no se piden permisos de medios. -->

</manifest>
