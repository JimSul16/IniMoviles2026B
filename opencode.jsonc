{
  "$schema": "https://opencode.ai/config.json",

  // Se cargan en TODAS las sesiones (los 3 modelos arrancan con el plan y el pase de testigo)
  "instructions": ["PLAN.md", "HANDOFF.md"],

  // SKILLS del proyecto (6 en total):
  //   .agents/skills/  → 4 skills de Antigravity (van dentro del repo → al clonarlas ya están)
  //   .opencode/skills/ → 2 skills creadas para este proyecto (auto-descubiertas)
  //   (mismo contenido en ~/.gemini/config/skills/ para Antigravity a nivel global)
  "skills": [".agents/skills", ".opencode/skills"],

  // Permite que un subagente lance al siguiente (p. ej. revisor → verificador-build)
  "experimental": {
    "subagent_depth": 2
  }

  // ⚠️ NO se fija "model" aquí a propósito: hasta que ejecutes `/connect` → Google y
  //    `/models` (Gemini 3.8 Flash), el modelo se elige en el TUI con el selector.
  //    Cuando esté conectado, puedes poner aquí el default:
  //    "model": "google/gemini-3.8-flash"   ← ajusta el ID al que muestre /models
}
